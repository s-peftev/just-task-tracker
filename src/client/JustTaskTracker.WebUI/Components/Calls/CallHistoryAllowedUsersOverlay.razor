@using JustTaskTracker.WebUI.Components.Shared
@using JustTaskTracker.WebUI.Domain.Auth

<div class="board-members-overlay"
     role="dialog"
     aria-modal="true"
     aria-label="Allowed to join">
    <button type="button"
            class="board-members-overlay__backdrop"
            aria-label="Close allowed users"
            @onclick="Close"></button>

    <div class="board-members-overlay__panel"
         @onclick:stopPropagation="true"
         @onmousedown:stopPropagation="true">
        <div class="board-members-overlay__tabs board-members-overlay__tabs--with-close" role="tablist" aria-label="Allowed to join">
            <div class="board-members-overlay__tab board-members-overlay__tab--active" role="tab" aria-selected="true">
                Allowed to join
            </div>

            <button type="button"
                    class="btn-icon btn-icon--round btn-icon--sm board-members-overlay__close-btn"
                    aria-label="Close allowed users"
                    @onclick="Close">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M18 6L6 18M6 6l12 12"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round" />
                </svg>
            </button>
        </div>

        <div class="board-members-overlay__body">
            @if (Users.Count == 0)
            {
                <div class="board-members-overlay__state">
                    <p class="board-members-overlay__message">No one on the allow-list.</p>
                </div>
            }
            else
            {
                <ul class="board-members-overlay__list">
                    @foreach (var user in Users)
                    {
                        <li class="board-members-overlay__item">
                            <div class="board-members-overlay__member">
                                <div class="board-members-overlay__member-avatar-wrap">
                                    <UserAvatarPlaceholder Class="board-members-overlay__member-avatar"
                                                           Preset="UserAvatarPlaceholderPreset.Member"
                                                           DisplayName="@user.DisplayName"
                                                           Email="@user.Email"
                                                           ProfilePhotoUrl="@user.ProfilePhotoUrl"
                                                           Title="@user.Email" />
                                </div>
                                <span class="board-members-overlay__member-name">@UserDisplayFormatting.GetShortName(user)</span>
                                <span class="board-members-overlay__member-email">@user.Email</span>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<UserDto> Users { get; set; } = [];

    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

    private Task Close() => OnClose.InvokeAsync();
}
