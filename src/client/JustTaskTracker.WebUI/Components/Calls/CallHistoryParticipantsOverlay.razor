@using JustTaskTracker.WebUI.Components.Shared
@using JustTaskTracker.WebUI.Domain.Auth
@using JustTaskTracker.WebUI.Domain.Calls

<div class="board-members-overlay"
     role="dialog"
     aria-modal="true"
     aria-label="Call participants">
    <button type="button"
            class="board-members-overlay__backdrop"
            aria-label="Close participants"
            @onclick="Close"></button>

    <div class="board-members-overlay__panel"
         @onclick:stopPropagation="true"
         @onmousedown:stopPropagation="true">
        <div class="board-members-overlay__tabs board-members-overlay__tabs--with-close" role="tablist" aria-label="Call participants">
            <div class="board-members-overlay__tab board-members-overlay__tab--active" role="tab" aria-selected="true">
                Participants
            </div>

            <button type="button"
                    class="btn-icon btn-icon--round btn-icon--sm board-members-overlay__close-btn"
                    aria-label="Close participants"
                    @onclick="Close">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M18 6L6 18M6 6l12 12"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round" />
                </svg>
            </button>
        </div>

        <div class="board-members-overlay__body">
            @if (Participants.Count == 0)
            {
                <div class="board-members-overlay__state">
                    <p class="board-members-overlay__message">No participants recorded.</p>
                </div>
            }
            else
            {
                <ul class="board-members-overlay__list">
                    @foreach (var participant in Participants)
                    {
                        <li class="board-members-overlay__item">
                            <div class="board-members-overlay__member">
                                <div class="board-members-overlay__member-avatar-wrap">
                                    <UserAvatarPlaceholder Class="board-members-overlay__member-avatar"
                                                           Preset="UserAvatarPlaceholderPreset.Member"
                                                           DisplayName="@participant.User.DisplayName"
                                                           Email="@participant.User.Email"
                                                           ProfilePhotoUrl="@participant.User.ProfilePhotoUrl"
                                                           Title="@participant.User.Email" />
                                </div>
                                <span class="board-members-overlay__member-name">@UserDisplayFormatting.GetShortName(participant.User)</span>
                                <span class="board-members-overlay__member-email">@participant.User.Email</span>
                                <span class="call-history-participants-overlay__times">@GetTimesCaption(participant)</span>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<CallHistoryParticipantDto> Participants { get; set; } = [];

    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

    private static string GetTimesCaption(CallHistoryParticipantDto participant)
    {
        var joined = participant.FirstJoinedAtUtc.ToLocalTime().ToString("g");
        var left = participant.LastLeftAtUtc is { } lastLeftAtUtc ? lastLeftAtUtc.ToLocalTime().ToString("g") : "—";

        return $"Joined {joined}, left {left}";
    }

    private Task Close() => OnClose.InvokeAsync();
}
