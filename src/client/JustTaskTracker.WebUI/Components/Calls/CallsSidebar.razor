@using JustTaskTracker.WebUI.Components.Shared
@using JustTaskTracker.WebUI.Components.Shared.Forms
@using JustTaskTracker.WebUI.Domain.Calls
@using JustTaskTracker.WebUI.Infrastructure
@using JustTaskTracker.WebUI.Services.Abstractions.Boards
@using JustTaskTracker.WebUI.Services.Abstractions.Calls
@using JustTaskTracker.WebUI.Services.Exceptions
@using JustTaskTracker.WebUI.Validation
@implements IDisposable
@inject ICallSessionStore CallSessionStore
@inject IBoardDetailsStore BoardDetailsStore
@inject ICallsInteropService CallsInteropService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<aside class="calls-sidebar @(CallSessionStore.IsSidebarOpen ? "calls-sidebar--open" : null)" aria-hidden="@(!CallSessionStore.IsSidebarOpen)">
    <div class="calls-sidebar__scrim" aria-hidden="true"></div>
    <div class="calls-sidebar__drawer">
        <div class="calls-sidebar__edge" aria-hidden="true"></div>
        <div class="calls-sidebar__panel">
            <header class="calls-sidebar__hub-header">
                <h2 class="calls-sidebar__hub-title">Board Meetings Hub</h2>

                <div class="calls-sidebar__hub-actions">
                    @if (BoardDetailsStore.Board is not { IsArchived: true })
                    {
                        <button type="button"
                                class="calls-sidebar__create-meeting-btn"
                                @onclick="CreateCallAsync">
                            Create new meeting
                        </button>
                    }

                    <button type="button"
                            class="calls-sidebar__close btn-icon btn-icon--sm"
                            aria-label="Close video calls"
                            title="Close"
                            @onclick="CloseSidebar">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path fill="none"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  d="M18 6L6 18M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </header>

            <div class="calls-sidebar__body">
                <section class="calls-sidebar__main" aria-label="Meeting details">
                </section>

                <div class="calls-sidebar__rail">
                    @if (BoardDetailsStore.Board is not { IsArchived: true })
                    {
                        <ActiveCallsTab BoardId="BoardId"
                                        OnShowLinkedTasks="callId => ShowActiveOverlay(callId, ActiveCallOverlayKind.LinkedTasks)"
                                        OnShowParticipants="callId => ShowActiveOverlay(callId, ActiveCallOverlayKind.Participants)"
                                        OnShowAllowedUsers="callId => ShowActiveOverlay(callId, ActiveCallOverlayKind.AllowedUsers)" />
                    }

                    <section class="calls-sidebar__section calls-sidebar__section--history"
                             aria-label="Recently ended">
                        <header class="calls-sidebar__header calls-sidebar__header--recent">
                            <h2 class="calls-sidebar__title calls-sidebar__title--recent">RECENTLY ENDED</h2>
                        </header>

                        <div class="calls-sidebar__section-body">
                            @if (CallSessionStore.IsLoadingHistory && CallSessionStore.History.Count == 0)
                            {
                                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                            }
                            else if (CallSessionStore.History.Count == 0)
                            {
                                <p class="calls-sidebar__empty">No call history on this board.</p>
                            }
                            else
                            {
                                <table class="calls-history-table">
                                    <thead>
                                        <tr>
                                            <th scope="col" class="calls-history-table__name">Title</th>
                                            <th scope="col" class="calls-history-table__date">Date</th>
                                            <th scope="col" class="calls-history-table__duration">Duration</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var session in CallSessionStore.History)
                                        {
                                            <CallHistoryCard Session="session" />
                                        }
                                    </tbody>
                                </table>

                                @if (CallSessionStore.HasMoreHistory)
                                {
                                    <ExpandableActionButton Text="Show more"
                                                            Icon="ExpandableActionButtonIcon.ChevronDown"
                                                            Disabled="@CallSessionStore.IsLoadingMoreHistory"
                                                            OnClick="LoadMoreHistoryAsync" />
                                }
                            }
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</aside>

@* Overlays render here, as siblings of <aside>, deliberately outside calls-sidebar__drawer: that
   element has `transform` (for the slide-in animation), which would otherwise clip a
   `position: fixed` overlay to the sidebar's own bounds instead of covering the viewport. *@
@if (_activeOverlayKind == ActiveCallOverlayKind.LinkedTasks && ActiveOverlaySession is { } activeTasksSession)
{
    <CallLinkedTasksOverlay BoardId="BoardId" Tasks="activeTasksSession.LinkedTasks" OnClose="CloseActiveOverlay" />
}
else if (_activeOverlayKind == ActiveCallOverlayKind.Participants && ActiveOverlaySession is { } activeParticipantsSession)
{
    <CallParticipantsOverlay Participants="GetActiveParticipantEntries(activeParticipantsSession)"
                             EmptyMessage="No one is in this call yet."
                             OnClose="CloseActiveOverlay" />
}
else if (_activeOverlayKind == ActiveCallOverlayKind.AllowedUsers && ActiveOverlaySession?.AllowedUsers is { } activeAllowedUsers)
{
    <CallAllowedUsersOverlay Users="activeAllowedUsers" OnClose="CloseActiveOverlay" />
}

@code {
    private enum ActiveCallOverlayKind
    {
        None,
        LinkedTasks,
        Participants,
        AllowedUsers,
    }

    [Parameter, EditorRequired]
    public Guid BoardId { get; set; }

    private Guid? _activeOverlayCallId;
    private ActiveCallOverlayKind _activeOverlayKind = ActiveCallOverlayKind.None;

    // Resolved live from the store rather than captured at click-time -- ApplyCallStateNotification
    // (Story 3.2) replaces the whole ActiveCalls list on every participant/presenter event, so a
    // captured CallSessionDto reference would otherwise go stale while an overlay is open.
    private CallSessionDto? ActiveOverlaySession =>
        _activeOverlayCallId is { } callId
            ? CallSessionStore.ActiveCalls.FirstOrDefault(c => c.Id == callId)
            : null;

    protected override void OnInitialized()
    {
        CallSessionStore.StateChanged += OnStoreStateChanged;
        BoardDetailsStore.StateChanged += OnStoreStateChanged;
    }

    private void CloseSidebar() =>
        CallSessionStore.CloseSidebar();

    private async Task CreateCallAsync()
    {
        var submitState = new ResourceFormDialogState();

        var dialog = await DialogService.ShowResourceFormAsync(
            "Create video call",
            "Create",
            CreateCallForm.FormId,
            CreateCallForm.Render(BoardId, submitState),
            submitState: submitState);

        var result = await dialog.Result;

        if (result is not { Canceled: false, Data: CreateCallResult callResult })
            return;

        var session = await CallSessionStore.CreateCallAsync(
            BoardId,
            callResult.Title,
            callResult.Topic,
            callResult.Visibility,
            callResult.AllowedUserIds,
            callResult.LinkedTaskIds);

        if (session is null)
        {
            if (CallSessionStore.ErrorMessage is { } error)
                Snackbar.Add(error, Severity.Error);

            return;
        }

        await JoinCallAsync(session);
    }

    private async Task JoinCallAsync(CallSessionDto call)
    {
        var environment = await CallsInteropService.CheckEnvironmentAsync();

        if (!environment.IsSupported)
        {
            Snackbar.Add(environment.Reason ?? "This browser doesn't support video calls.", Severity.Error);
            return;
        }

        Navigation.NavigateTo($"/boards/{BoardId}/calls/{call.Id}");
    }

    private void ShowActiveOverlay(Guid callId, ActiveCallOverlayKind kind)
    {
        _activeOverlayCallId = callId;
        _activeOverlayKind = kind;
    }

    private void CloseActiveOverlay()
    {
        _activeOverlayCallId = null;
        _activeOverlayKind = ActiveCallOverlayKind.None;
    }

    private async Task LoadMoreHistoryAsync()
    {
        try
        {
            await CallSessionStore.LoadMoreHistoryAsync();
        }
        catch (ApiServiceException ex)
        {
            Snackbar.ShowApiError(ex);
        }
    }

    private void OnStoreStateChanged() => InvokeAsync(StateHasChanged);

    private static IReadOnlyList<CallParticipantsOverlay.Entry> GetActiveParticipantEntries(CallSessionDto call) =>
        call.Participants.Select(u => new CallParticipantsOverlay.Entry(u)).ToList();

    public void Dispose()
    {
        CallSessionStore.StateChanged -= OnStoreStateChanged;
        BoardDetailsStore.StateChanged -= OnStoreStateChanged;
    }
}
