@using JustTaskTracker.WebUI.Components.Shared
@using JustTaskTracker.WebUI.Domain.Boards.Authorization
@using JustTaskTracker.WebUI.Domain.Calls
@using JustTaskTracker.WebUI.Domain.Calls.Enums
@using JustTaskTracker.WebUI.Infrastructure
@using JustTaskTracker.WebUI.Services.Abstractions.Auth
@using JustTaskTracker.WebUI.Services.Abstractions.Boards
@using JustTaskTracker.WebUI.Services.Abstractions.Calls
@using JustTaskTracker.WebUI.Services.Exceptions
@using JustTaskTracker.WebUI.Validation
@implements IDisposable
@inject ICallSessionStore CallSessionStore
@inject ICallsInteropService CallsInteropService
@inject IBoardDetailsStore BoardDetailsStore
@inject IProfileStore ProfileStore
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<aside class="calls-sidebar @(CallSessionStore.IsSidebarOpen ? "calls-sidebar--open" : null)" aria-hidden="@(!CallSessionStore.IsSidebarOpen)">
    <div class="calls-sidebar__panel">
        @if (BoardDetailsStore.Board is not { IsArchived: true })
        {
            <section class="calls-sidebar__section calls-sidebar__section--active" aria-label="Active video calls">
                <header class="calls-sidebar__header">
                    <h2 class="calls-sidebar__title">Active video calls</h2>
                    <button type="button"
                            class="calls-sidebar__create-btn"
                            @onclick="CreateCallAsync">
                        create call
                    </button>
                </header>

                <div class="calls-sidebar__section-body">
                    @if (CallSessionStore.IsLoadingActiveCalls)
                    {
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                    }
                    else if (CallSessionStore.ActiveCalls.Count == 0)
                    {
                        <p class="calls-sidebar__empty">No active calls on this board.</p>
                    }
                    else
                    {
                        <ul class="calls-sidebar__list">
                            @foreach (var call in CallSessionStore.ActiveCalls)
                            {
                                <li class="calls-sidebar__call-card">
                                    <div class="calls-sidebar__call-body">
                                        <span class="calls-sidebar__call-title"
                                              title="@call.Title">@call.Title</span>
                                        <span class="calls-sidebar__call-topic @(string.IsNullOrWhiteSpace(call.Topic) ? "calls-sidebar__call-topic--empty" : null)"
                                              title="@call.Topic">@(string.IsNullOrWhiteSpace(call.Topic) ? "\u00a0" : call.Topic)</span>
                                    </div>

                                    <footer class="calls-sidebar__call-footer">
                                        <span class="calls-sidebar__call-visibility">
                                            @(call.Visibility == CallVisibility.Restricted ? "Restricted" : "Open")
                                        </span>

                                        @if (CallSessionStore.CurrentCallId == call.Id)
                                        {
                                            <span class="calls-sidebar__in-call-label">In call</span>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="calls-sidebar__join-btn"
                                                    aria-label="Join call"
                                                    disabled="@(!CanJoin(call))"
                                                    title="@(CanJoin(call) ? "Join call" : "You're not on this restricted call's allow-list.")"
                                                    @onclick="() => JoinCallAsync(call)">
                                                <svg viewBox="0 0 24 24"
                                                     aria-hidden="true"
                                                     focusable="false">
                                                    <path fill="none"
                                                          stroke="currentColor"
                                                          stroke-width="2"
                                                          stroke-linecap="round"
                                                          stroke-linejoin="round"
                                                          d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3" />
                                                </svg>
                                            </button>
                                        }
                                    </footer>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>
        }

        <section class="calls-sidebar__section calls-sidebar__section--history @GetHistorySectionClass()"
                 aria-label="Video calls history">
            <header class="calls-sidebar__header">
                <button type="button"
                        class="calls-sidebar__history-toggle"
                        aria-expanded="@_isHistoryExpanded"
                        @onclick="ToggleHistorySection">
                    <span class="calls-sidebar__title">Video calls history</span>
                </button>
            </header>

            <div class="calls-sidebar__section-body calls-sidebar__section-body--history">
                @if (CallSessionStore.IsLoadingHistory && CallSessionStore.History.Count == 0)
                {
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                }
                else if (CallSessionStore.History.Count == 0)
                {
                    <p class="calls-sidebar__empty">No call history on this board.</p>
                }
                else
                {
                    <ul class="calls-sidebar__list">
                        @foreach (var session in CallSessionStore.History)
                        {
                            <CallHistoryCard Session="session"
                                             OnShowLinkedTasks="() => ShowHistoryOverlay(session, HistoryOverlayKind.LinkedTasks)"
                                             OnShowParticipants="() => ShowHistoryOverlay(session, HistoryOverlayKind.Participants)"
                                             OnShowAllowedUsers="() => ShowHistoryOverlay(session, HistoryOverlayKind.AllowedUsers)" />
                        }

                        @if (CallSessionStore.HasMoreHistory)
                        {
                            <li>
                                <ExpandableActionButton Text="Show more"
                                                        Icon="ExpandableActionButtonIcon.ChevronDown"
                                                        Disabled="@CallSessionStore.IsLoadingMoreHistory"
                                                        OnClick="LoadMoreHistoryAsync" />
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>
    </div>
</aside>

@if (_historyOverlayKind == HistoryOverlayKind.LinkedTasks && _historyOverlaySession is { } tasksSession)
{
    <CallHistoryLinkedTasksOverlay BoardId="BoardId" Tasks="tasksSession.LinkedTasks" OnClose="CloseHistoryOverlay" />
}
else if (_historyOverlayKind == HistoryOverlayKind.Participants && _historyOverlaySession is { } participantsSession)
{
    <CallHistoryParticipantsOverlay Participants="participantsSession.Participants" OnClose="CloseHistoryOverlay" />
}
else if (_historyOverlayKind == HistoryOverlayKind.AllowedUsers && _historyOverlaySession?.AllowedUsers is { } allowedUsers)
{
    <CallHistoryAllowedUsersOverlay Users="allowedUsers" OnClose="CloseHistoryOverlay" />
}

@code {
    private enum HistoryOverlayKind
    {
        None,
        LinkedTasks,
        Participants,
        AllowedUsers,
    }

    [Parameter, EditorRequired]
    public Guid BoardId { get; set; }

    private bool _isHistoryExpanded = true;
    private HistoryOverlayKind _historyOverlayKind = HistoryOverlayKind.None;
    private CallSessionHistoryDto? _historyOverlaySession;

    protected override void OnInitialized()
    {
        CallSessionStore.StateChanged += OnStoreStateChanged;
        BoardDetailsStore.StateChanged += OnStoreStateChanged;
    }

    private void ToggleHistorySection() =>
        _isHistoryExpanded = !_isHistoryExpanded;

    private string? GetHistorySectionClass() =>
        _isHistoryExpanded ? null : "calls-sidebar__section--history-collapsed";

    private void ShowHistoryOverlay(CallSessionHistoryDto session, HistoryOverlayKind kind)
    {
        _historyOverlaySession = session;
        _historyOverlayKind = kind;
    }

    private void CloseHistoryOverlay()
    {
        _historyOverlaySession = null;
        _historyOverlayKind = HistoryOverlayKind.None;
    }

    private async Task LoadMoreHistoryAsync()
    {
        try
        {
            await CallSessionStore.LoadMoreHistoryAsync();
        }
        catch (ApiServiceException ex)
        {
            Snackbar.ShowApiError(ex);
        }
    }

    private bool CanJoin(CallSessionDto call)
    {
        if (call.Visibility != CallVisibility.Restricted)
            return true;

        if (ProfileStore.Profile is { } profile && call.CreatedByUserId == profile.Id)
            return true;

        if (BoardDetailsStore.Board is { } board && BoardRolePermissions.CanBypassCallRestriction(board.UserRole))
            return true;

        return ProfileStore.Profile is { } currentUser
            && (call.AllowedUserIds?.Contains(currentUser.Id) ?? false);
    }

    private async Task CreateCallAsync()
    {
        var submitState = new ResourceFormDialogState();

        var dialog = await DialogService.ShowResourceFormAsync(
            "Create video call",
            "Create",
            CreateCallForm.FormId,
            CreateCallForm.Render(BoardId, submitState),
            submitState: submitState);

        var result = await dialog.Result;

        if (result is not { Canceled: false, Data: CreateCallResult callResult })
            return;

        var session = await CallSessionStore.CreateCallAsync(
            BoardId,
            callResult.Title,
            callResult.Topic,
            callResult.Visibility,
            callResult.AllowedUserIds,
            callResult.LinkedTaskIds);

        if (session is null)
        {
            if (CallSessionStore.ErrorMessage is { } error)
                Snackbar.Add(error, Severity.Error);

            return;
        }

        await JoinCallAsync(session);
    }

    private async Task JoinCallAsync(CallSessionDto call)
    {
        var environment = await CallsInteropService.CheckEnvironmentAsync();

        if (!environment.IsSupported)
        {
            Snackbar.Add(environment.Reason ?? "This browser doesn't support video calls.", Severity.Error);
            return;
        }

        Navigation.NavigateTo($"/boards/{BoardId}/calls/{call.Id}");
    }

    private void OnStoreStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CallSessionStore.StateChanged -= OnStoreStateChanged;
        BoardDetailsStore.StateChanged -= OnStoreStateChanged;
    }
}
