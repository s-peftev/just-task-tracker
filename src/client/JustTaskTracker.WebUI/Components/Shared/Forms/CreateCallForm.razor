@using JustTaskTracker.WebUI.Components.Shared
@using JustTaskTracker.WebUI.Domain.Calls
@using JustTaskTracker.WebUI.Domain.Calls.Enums
@using JustTaskTracker.WebUI.Services.Abstractions.Auth
@using JustTaskTracker.WebUI.Services.Abstractions.Calls
@using JustTaskTracker.WebUI.Validation
@implements IDisposable
@inject IProfileStore ProfileStore
@inject ICallParticipantPickerStore ParticipantPickerStore

<form id="@FormId" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
    <div @onfocusout="OnFieldFocusOutAsync">
        <MudTextField @bind-Value="_model.Title"
                      @bind-Value:after="OnFieldChangedAsync"
                      Label="Title"
                      Variant="Variant.Outlined"
                      Counter="@CallFieldLengths.MaxTitleLength"
                      MaxLength="@CallFieldLengths.MaxTitleLength"
                      AutoFocus="true"
                      Required="false"
                      OnlyValidateIfDirty="true"
                      Error="_showValidation && _titleError is not null"
                      ErrorText="@(_showValidation ? _titleError : null)" />

        <MudTextField @bind-Value="_model.Topic"
                      @bind-Value:after="OnFieldChangedAsync"
                      Label="Topic (optional)"
                      Variant="Variant.Outlined"
                      Lines="3"
                      Counter="@CallFieldLengths.MaxTopicLength"
                      MaxLength="@CallFieldLengths.MaxTopicLength"
                      Required="false"
                      OnlyValidateIfDirty="true"
                      Error="_showValidation && _topicError is not null"
                      ErrorText="@(_showValidation ? _topicError : null)"
                      Class="mt-4" />
    </div>

    <fieldset class="create-call-form__visibility-fieldset">
        <legend class="create-call-form__visibility-legend">Visibility</legend>

        <MudRadioGroup T="CallVisibility" @bind-Value="_model.Visibility" @bind-Value:after="UpdateSubmitState">
            <MudRadio T="CallVisibility" Value="CallVisibility.Open" Color="Color.Primary">
                Open — any board member can join
            </MudRadio>
            <MudRadio T="CallVisibility" Value="CallVisibility.Restricted" Color="Color.Primary">
                Restricted — only selected members can join
            </MudRadio>
        </MudRadioGroup>
    </fieldset>

    <div class="create-call-form__members">
        <button type="button"
                class="btn-glass-white create-call-form__members-btn"
                disabled="@(_model.Visibility != CallVisibility.Restricted)"
                @onclick="OpenParticipantPickerAsync">
            Select members
            @if (_model.Visibility == CallVisibility.Restricted)
            {
                <span class="create-call-form__members-count">(@ParticipantPickerStore.SelectedUserIds.Count selected)</span>
            }
        </button>

        @if (_showValidation && _model.Visibility == CallVisibility.Restricted && _membersError is not null)
        {
            <MudText Typo="Typo.caption" Color="Color.Error" Class="create-call-form__members-error">
                @_membersError
            </MudText>
        }
    </div>
</form>

@code {
    [Parameter, EditorRequired]
    public Guid BoardId { get; set; }

    [Parameter, EditorRequired]
    public ResourceFormDialogState SubmitState { get; set; } = default!;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly CreateCallModel _model = new();
    private readonly CreateCallModelValidator _validator = new();
    private bool _showValidation;
    private bool _isDirty;
    private string? _titleError;
    private string? _topicError;
    private string? _membersError;

    protected override void OnInitialized()
    {
        ParticipantPickerStore.StateChanged += OnParticipantPickerStateChanged;

        if (ProfileStore.Profile is { } profile)
            ParticipantPickerStore.Reset(profile.Id);

        UpdateSubmitState();
    }

    public void Dispose() =>
        ParticipantPickerStore.StateChanged -= OnParticipantPickerStateChanged;

    private void OnParticipantPickerStateChanged()
    {
        UpdateSubmitState();
        InvokeAsync(StateHasChanged);
    }

    private async Task OnFieldChangedAsync()
    {
        _isDirty = true;

        if (_showValidation)
            await ValidateAsync();
    }

    private async Task OnFieldFocusOutAsync(FocusEventArgs _)
    {
        if (_showValidation || !_isDirty)
            return;

        _showValidation = true;
        await ValidateAsync();
    }

    private Task OpenParticipantPickerAsync()
    {
        if (_model.Visibility != CallVisibility.Restricted)
            return Task.CompletedTask;

        return ParticipantPickerStore.OpenAsync(BoardId);
    }

    private void UpdateSubmitState()
    {
        var hasEnoughMembers = _model.Visibility != CallVisibility.Restricted
            || ParticipantPickerStore.SelectedUserIds.Count >= 2;

        SubmitState.SetDisableSubmit(!hasEnoughMembers);
    }

    private async Task SubmitAsync()
    {
        _showValidation = true;
        await ValidateAsync();

        _membersError = _model.Visibility == CallVisibility.Restricted && ParticipantPickerStore.SelectedUserIds.Count < 2
            ? "Select at least one board member besides yourself."
            : null;

        if (_titleError is not null || _topicError is not null || _membersError is not null)
            return;

        var topic = string.IsNullOrWhiteSpace(_model.Topic) ? null : _model.Topic.Trim();

        var allowedUserIds = _model.Visibility == CallVisibility.Restricted
            ? ParticipantPickerStore.SelectedUserIds.ToList()
            : null;

        MudDialog.Close(DialogResult.Ok(new CreateCallResult(_model.Title.Trim(), topic, _model.Visibility, allowedUserIds)));
    }

    private async Task ValidateAsync()
    {
        if (!_showValidation)
        {
            _titleError = null;
            _topicError = null;
            return;
        }

        var result = await _validator.ValidateAsync(_model);
        _titleError = result.Errors.FirstOrDefault(e => e.PropertyName == nameof(CreateCallModel.Title))?.ErrorMessage;
        _topicError = result.Errors.FirstOrDefault(e => e.PropertyName == nameof(CreateCallModel.Topic))?.ErrorMessage;
    }

    public const string FormId = "create-call-form";

    public static RenderFragment Render(Guid boardId, ResourceFormDialogState submitState) => builder =>
    {
        builder.OpenComponent<CreateCallForm>(0);
        builder.AddAttribute(1, nameof(BoardId), boardId);
        builder.AddAttribute(2, nameof(SubmitState), submitState);
        builder.CloseComponent();
    };
}
